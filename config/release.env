# AtlANTian release identity.
#
# Debian generation and AtlANTian release semantics are intentionally separate:
#   <Debian major>.<AtlANTian minor>.<AtlANTian patch>[-prerelease]
# Example: 13.1.0-alpha.1 is the first AtlANTian release line based on Debian 13.
#
# These values define the release line and its initial sequence. CI derives the
# next publishable patch/prerelease number from existing repository tags. A
# Debian-major transition remains an explicit release-line decision and updates
# both DEBIAN_* and the first component of ATLANTIAN_VERSION together.
DEBIAN_CODENAME=trixie
DEBIAN_MAJOR=13

ATLANTIAN_MINOR=1
ATLANTIAN_PATCH=${ATLANTIAN_PATCH_OVERRIDE:-0}
# Empty for a stable release; otherwise use an automatically numbered channel
# such as alpha.1, beta.1 or rc.1.
if [ "${ATLANTIAN_PRERELEASE_OVERRIDE+x}" = x ]; then
  ATLANTIAN_PRERELEASE=$ATLANTIAN_PRERELEASE_OVERRIDE
else
  ATLANTIAN_PRERELEASE=alpha.1
fi
# Debian package revision. Release-version changes normally leave this at 1.
ATLANTIAN_DEBIAN_REVISION=1

ATLANTIAN_VERSION_CORE="${DEBIAN_MAJOR}.${ATLANTIAN_MINOR}.${ATLANTIAN_PATCH}"
if [ -n "$ATLANTIAN_PRERELEASE" ]; then
  ATLANTIAN_VERSION="${ATLANTIAN_VERSION_CORE}-${ATLANTIAN_PRERELEASE}"
  # Debian uses '~' so prereleases sort before the corresponding stable version.
  ATLANTIAN_DEB_VERSION="${ATLANTIAN_VERSION_CORE}~${ATLANTIAN_PRERELEASE}-${ATLANTIAN_DEBIAN_REVISION}"
else
  ATLANTIAN_VERSION="$ATLANTIAN_VERSION_CORE"
  ATLANTIAN_DEB_VERSION="${ATLANTIAN_VERSION_CORE}-${ATLANTIAN_DEBIAN_REVISION}"
fi

# Git identity is diagnostic metadata, never part of release ordering.
ATLANTIAN_SOURCE_REVISION=${ATLANTIAN_SOURCE_REVISION:-$(git rev-parse --short=12 HEAD 2>/dev/null || printf 'local')}
ATLANTIAN_SOURCE_ID=${ATLANTIAN_SOURCE_ID:-"${ATLANTIAN_VERSION}+g${ATLANTIAN_SOURCE_REVISION}"}
ATLANTIAN_RELEASE_ID=${ATLANTIAN_RELEASE_ID:-"atlantian-${ATLANTIAN_VERSION}"}
ATLANTIAN_IMAGE_NAME=${ATLANTIAN_IMAGE_NAME:-"${ATLANTIAN_RELEASE_ID}"}

ATLANTIAN_KERNEL_VERSION=6.12.100
# Immutable kernel source input for published releases. The annotated stable
# tag is resolved once here rather than trusting a movable remote ref in CI.
ATLANTIAN_KERNEL_COMMIT=52a355b23cd2dd77b683ed1a1bbe2b7408bd9c74
# Kernel ABI revision is independent of userspace releases. Increment only when
# AtlANTian changes its kernel/config ABI, not for ordinary distro releases.
ATLANTIAN_KERNEL_ABI=1
# CONFIG_LOCALVERSION_AUTO is disabled by build-kernel.sh: no git hash and no
# accidental "-dirty" suffix may enter the published kernel release string.
ATLANTIAN_KERNEL_LOCALVERSION="-atlantian${ATLANTIAN_KERNEL_ABI}"
