# Simple, conventional removable-media layout.  The image has only BOOT and
# root.  p2 is enlarged to the full card on its first boot; there is no hidden
# state partition and no reserved update area.
# 48 MiB leaves ample room for the normal boot payload plus the temporary NAND
# installer staging files without carrying 64 MiB of mostly empty FAT space.
ATLANTIAN_BOOT_MIB=48
# This is temporary formatting/copying headroom, not reserved runtime space:
# p2 expands to the complete SD card on first boot.  The image builder retries
# ENOSPC in small increments, so a large permanent factory-image reserve is not
# needed merely to cover ext4 metadata and inode allocation uncertainty.
ATLANTIAN_INITIAL_ROOT_SLACK_MIB=16
