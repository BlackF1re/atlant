# Antminer S9 2-Gbit raw NAND geometry and AtlANTian NAND edition policy.
# Destructive tools must still verify the live device before using these values.
ATLANTIAN_NAND_TOTAL_MIB=256
ATLANTIAN_NAND_ERASE_BYTES=131072
ATLANTIAN_NAND_PAGE_BYTES=2048
ATLANTIAN_NAND_OOB_BYTES=64

# Stock MT29F2G08ABAEAWP ECC contract. BootROM, U-Boot and Linux must all use
# the NAND's Micron on-die BCH engine; Zynq's controller-side 1-bit ECC is not
# strong enough for this part and software BCH must not become the active path.
ATLANTIAN_NAND_ECC_ENGINE=ondie
ATLANTIAN_NAND_ECC_ALGO=bch
ATLANTIAN_NAND_ECC_STRENGTH=4
ATLANTIAN_NAND_ECC_STEP_BYTES=512

# Keep the first 16 MiB outside UBI because BootROM/SPL/U-Boot require raw,
# fixed-address boot assets. On the observed MT29F2G08ABAEAWP, BootROM,
# U-Boot and Linux all use the NAND's Micron on-die BCH engine (4 bits per
# 512-byte step); the 16 MiB split is therefore a boot/storage boundary, not
# an ECC-layout boundary.
ATLANTIAN_NAND_BOOT_MIB=16
ATLANTIAN_NAND_UBI_OFFSET_BYTES=16777216
ATLANTIAN_NAND_UBI_MIB=240

# Standard UBI geometry for 128 KiB PEBs and 2 KiB minimum I/O. EC and VID
# headers consume the first 4 KiB, leaving 126,976 bytes per logical eraseblock.
ATLANTIAN_NAND_LEB_BYTES=126976

# Raw boot slots. Each slot deliberately includes slack for factory-bad blocks:
# normal U-Boot `nand write/read` skip them while preserving the logical stream.
ATLANTIAN_NAND_SPL_AREA_BYTES=1048576
ATLANTIAN_NAND_SPL_COPIES=4
ATLANTIAN_NAND_UBOOT_PRIMARY_OFFSET=1048576
ATLANTIAN_NAND_UBOOT_REDUND_OFFSET=2097152
ATLANTIAN_NAND_UBOOT_SLOT_BYTES=1048576
ATLANTIAN_NAND_KERNEL_OFFSET=3145728
ATLANTIAN_NAND_KERNEL_SLOT_BYTES=9437184
ATLANTIAN_NAND_INITRD_OFFSET=12582912
ATLANTIAN_NAND_INITRD_SLOT_BYTES=3145728
ATLANTIAN_NAND_DTB_OFFSET=15728640
ATLANTIAN_NAND_DTB_SLOT_BYTES=1048576

# A NAND release is rejected unless, after allocating its immutable rootfs,
# these resources can still exist. UBI additionally maintains its own bad-PEB
# pool at runtime; the CI reserve below is deliberately pessimistic.
ATLANTIAN_NAND_MIN_OVERLAY_MIB=32
ATLANTIAN_NAND_CI_BAD_PEB_RESERVE=32

# Storage policy: immutable data belongs in a dense read-only SquashFS inside a
# static UBI volume. ubiblock exposes that volume as a read-only block device.
# The writable upper remains UBIFS so it keeps NAND-aware recovery, wear-leveling
# and power-cut semantics. Zstd maximizes lower-layer density; LZO keeps writes
# and boot-time metadata work cheap on the Cortex-A9 while still saving space.
ATLANTIAN_NAND_ROOTFS_FORMAT=squashfs
ATLANTIAN_NAND_ROOTFS_COMPRESSOR=zstd
ATLANTIAN_NAND_ROOTFS_BLOCK_BYTES=262144
ATLANTIAN_NAND_ROOTFS_ZSTD_LEVEL=15
ATLANTIAN_NAND_OVERLAY_COMPRESSOR=lzo
