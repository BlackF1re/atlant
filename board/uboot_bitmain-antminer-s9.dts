/* AtlANTian U-Boot hardware contract for Bitmain Antminer S9. */
/dts-v1/;
#include "zynq-7000.dtsi"

/ {
	model = "Bitmain Antminer S9";
	compatible = "bitmain,antminer-s9", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		mmc0 = &sdhci0;
		gpio0 = &gpio0;
		nand0 = &nfc0;
	};

	/*
	 * Maximum DDR probe window. Antminer S9 U-Boot probes the installed RAM
	 * with get_ram_size(), so 512 MiB and 1 GiB boards share this description.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		bootcount@efffff0 { reg = <0x0efffff0 0x10>; no-map; };
		fpga_space@f000000 { reg = <0x0f000000 0x01000000>; no-map; };
	};

	chosen { stdout-path = "serial0:115200n8"; };

	/* The base image supplies FPGA infrastructure, never a bitstream. */
	fpga_full: fpga-full {
		compatible = "fpga-region";
		fpga-mgr = <&devcfg>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};
};

&clkc { ps-clk-frequency = <33333333>; };

&gem0 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;
	ethernet_phy: ethernet-phy@1 { reg = <1>; };
};

&sdhci0 { status = "okay"; disable-wp; };
&uart1 { status = "okay"; };
&gpio0 { status = "okay"; };
&devcfg { status = "okay"; };
&smcc { status = "okay"; };
&nfc0 {
	status = "okay";
	nand-bus-width = <8>;
	arm,nand-cycle-t0 = <1>;
	arm,nand-cycle-t1 = <1>;
	arm,nand-cycle-t2 = <0>;
	arm,nand-cycle-t3 = <0>;
	arm,nand-cycle-t4 = <0>;
	arm,nand-cycle-t5 = <0>;
	arm,nand-cycle-t6 = <0>;
};
&watchdog0 { reset-on-timeout; timeout-sec = <200>; };
